@model IEnumerable<ModuleHomework3.Models.Category>
@{
    ViewData["Title"] = "Категории товаров";
}

<h1>Категории товаров</h1>
<p><a href="/Category/Create" class="btn btn-success">+ Добавить категорию</a></p>

<table>
    <thead>
        <tr><th>ID</th><th>Название</th><th>Действия</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>
                <a href="/Category/Edit/@item.Id" class="btn btn-warning">✏ Изменить</a>
                <a href="/Category/Delete/@item.Id" class="btn btn-danger">🗑 Удалить</a>
            </td>
        </tr>
    }
    </tbody>
</table>
