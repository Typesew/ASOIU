@model ModuleHomework3.Models.Product
@{
    ViewData["Title"] = "Добавление товара";
    var categories = ViewBag.Categories as List<ModuleHomework3.Models.Category>;
}

<h1>Добавление товара</h1>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="CategoryId"></label>
        <select asp-for="CategoryId" class="form-control">
            <option value="">-- Выберите категорию --</option>
            @foreach (var cat in categories)
            {
                <option value="@cat.Id">@cat.Name</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="error"></span>
    </div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="error"></span>
    </div>
    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="error"></span>
    </div>
    <button type="submit" class="btn btn-success">Сохранить</button>
    <a href="/Product" class="btn btn-danger">Отмена</a>
</form>
